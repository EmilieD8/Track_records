{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "poc": {
      "root": "poc",
      "framework": "fastapi",
      "entrypoint": "api:app"
    },
    "web": {
      "root": "web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "poc" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
