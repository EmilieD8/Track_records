# Nebius Token Factory (OpenAI-compatible). Check the exact base URL in the Token Factory console.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Optional: NVIDIA API catalog (build.nvidia.com) for OCR/vision models
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
TAVILY_API_KEY=
# Fallback chat models if /models cannot be read; OCR models offered in the UI (first = default)
DEFAULT_MODELS=nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3.5-lightning-30b-a3b
OCR_MODELS=nvidia/nemotron-parse,nvidia/nemotron-parse-2.0,nvidia/nemotron-3.5-super-vl-120b-a12b
